# ---------------------------------------------------------------------------
# Frontend (Vite bakes these into the browser bundle at BUILD time — never
# put secrets here). Same Supabase project as below.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Backend (server/ — Express on Railway). These never reach the browser.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resume AI / Copilot / AI candidate matching. Leave both keys unset and
# those features clearly report "not configured" instead of pretending to
# work. AI_PROVIDER picks which one is active (default: openai) — only that
# provider's key needs to be set, but both can be present if you want to
# switch later without redeploying twice.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Transactional email (Resend: https://resend.com). Leave unset and the
# Email module reports "not configured" instead of faking a send.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# Railway sets PORT automatically in production — only needed for local dev
# if you want the API on a non-default port.
PORT=8787
