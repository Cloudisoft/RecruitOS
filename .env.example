# Supabase project (get from supabase.com dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (used by Supabase Edge Functions, never bundled into the frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=your-openai-key

# Optional: transactional email provider (Resend). If unset, Email module shows "not configured".
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
